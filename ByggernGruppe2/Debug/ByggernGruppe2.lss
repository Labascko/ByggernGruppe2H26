000009e4 <MCP2515_spi_read>:
void MCP2515_spi_write(uint8_t address, uint8_t data) {
	spi_mastertransmit(0x02, CAN); // WRITE-kommando
	spi_mastertransmit(address, CAN);
	spi_mastertransmit(data, CAN);
	slave_select(NONE);
}
